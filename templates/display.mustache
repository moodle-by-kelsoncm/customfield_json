{{!
    @template customfield_json/display

    JSON document of a custom field, pretty-printed with syntax highlighting.
    The html value comes from json_value::highlight(), which escapes every token.

    Example context (json):
    {"html": "<span class=\"customfield-json-punct\">{</span> <span class=\"customfield-json-key\">&quot;name&quot;</span><span class=\"customfield-json-punct\">:</span> <span class=\"customfield-json-string\">&quot;Ada&quot;</span> <span class=\"customfield-json-punct\">}</span>"}
}}
<pre class="customfield-json-display">{{{html}}}</pre>
